{
  "name": "AgentApprovalRequest",
  "type": "object",
  "title": "Agent Approval Request",
  "description": "A request to provision or modify an agent passport, pending human approval.",
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "new_agent",
        "modified_passport"
      ],
      "title": "Request Type",
      "default": "new_agent"
    },
    "request_uid": {
      "type": "string",
      "title": "Request UID",
      "description": "Human-readable unique request identifier (e.g. REQ-2026-0007)."
    },
    "agent_id": {
      "type": "string",
      "title": "Agent ID"
    },
    "name": {
      "type": "string",
      "title": "Agent Name"
    },
    "owner_name": {
      "type": "string",
      "title": "Owner Name"
    },
    "owner_email": {
      "type": "string",
      "format": "email",
      "title": "Owner Email"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Systems",
      "default": []
    },
    "financial_limit_usd": {
      "type": "number",
      "title": "Financial Limit (USD)",
      "default": 0
    },
    "financial_limit_mode": {
      "type": "string",
      "enum": [
        "approval_threshold",
        "hard_cap"
      ],
      "title": "Financial Limit Mode",
      "default": "approval_threshold"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "full",
        "standard",
        "restricted"
      ],
      "title": "Autonomy Level",
      "default": "standard"
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Prohibited Actions",
      "default": []
    },
    "data_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Data Permissions",
      "default": []
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ],
      "title": "Environment",
      "default": "prod"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "title": "Decision Deadline"
    },
    "action_params": {
      "type": "object",
      "title": "Exact Parameters",
      "additionalProperties": true,
      "default": {}
    },
    "linked_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Linked Evidence",
      "default": []
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "single_execution",
        "ongoing_access"
      ],
      "title": "Approval Scope",
      "default": "ongoing_access"
    },
    "approval_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Approval Expiration"
    },
    "execution_consumed": {
      "type": "boolean",
      "title": "Execution Consumed",
      "default": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Executed At"
    },
    "executed_action_id": {
      "type": "string",
      "title": "Executed Action Record ID"
    },
    "decision_history": {
      "type": "array",
      "title": "Decision History",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "requested_by": {
      "type": "string",
      "title": "Requested By"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "title": "Status",
      "default": "pending"
    },
    "approval_token": {
      "type": "string",
      "title": "Approval Token"
    },
    "decided_by": {
      "type": "string",
      "title": "Decided By"
    },
    "decided_date": {
      "type": "string",
      "format": "date-time",
      "title": "Decided Date"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Decision Reasons",
      "default": []
    },
    "resulting_agent_record_id": {
      "type": "string",
      "title": "Resulting Agent Record ID"
    }
  },
  "required": [
    "agent_id",
    "name",
    "owner_email",
    "request_type",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}