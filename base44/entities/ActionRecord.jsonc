{
  "name": "ActionRecord",
  "type": "object",
  "title": "Action Record",
  "description": "A governed action evaluated against an agent's passport, with full reasoning trace.",
  "properties": {
    "agent_id": {
      "type": "string",
      "title": "Agent ID"
    },
    "agent_name": {
      "type": "string",
      "title": "Agent Name"
    },
    "request_uid": {
      "type": "string",
      "title": "Request UID",
      "description": "Unique request identifier distinguishing otherwise-similar actions."
    },
    "action_type": {
      "type": "string",
      "title": "Action Type"
    },
    "target_system": {
      "type": "string",
      "title": "Target System"
    },
    "amount_usd": {
      "type": "number",
      "title": "Amount (USD)",
      "default": 0
    },
    "params": {
      "type": "object",
      "title": "Parameters",
      "additionalProperties": true,
      "default": {}
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ],
      "title": "Environment",
      "default": "prod"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "title": "Decision Deadline"
    },
    "linked_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Linked Evidence",
      "default": []
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "single_execution",
        "ongoing_access"
      ],
      "title": "Approval Scope",
      "default": "single_execution"
    },
    "approval_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Approval Expiration"
    },
    "execution_consumed": {
      "type": "boolean",
      "title": "Execution Consumed",
      "default": false
    },
    "executed_at": {
      "type": "string",
      "format": "date-time",
      "title": "Executed At"
    },
    "execution_outcome": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "unknown"
      ],
      "title": "Execution Outcome",
      "default": "unknown"
    },
    "decision_history": {
      "type": "array",
      "title": "Decision History",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "blast_radius_score": {
      "type": "integer",
      "title": "Blast Radius (1-5)",
      "minimum": 1,
      "maximum": 5,
      "default": 1
    },
    "reversibility": {
      "type": "string",
      "enum": [
        "reversible",
        "partially_reversible",
        "irreversible"
      ],
      "title": "Reversibility",
      "default": "reversible"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "approval_required",
        "blocked"
      ],
      "title": "Decision",
      "default": "allow"
    },
    "status": {
      "type": "string",
      "enum": [
        "executed",
        "pending_approval",
        "approved",
        "denied",
        "blocked"
      ],
      "title": "Status",
      "default": "executed"
    },
    "requested_by": {
      "type": "string",
      "title": "Requested By"
    },
    "policy_matches": {
      "type": "array",
      "title": "All Matched Policies",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "policy_matched_name": {
      "type": "string",
      "title": "Decisive Policy Name"
    },
    "policy_matched_priority": {
      "type": "integer",
      "title": "Decisive Policy Priority"
    },
    "financial_limit_mode": {
      "type": "string",
      "enum": [
        "approval_threshold",
        "hard_cap"
      ],
      "title": "Financial Limit Mode",
      "default": "approval_threshold"
    },
    "decided_by": {
      "type": "string",
      "title": "Decided By"
    },
    "decided_date": {
      "type": "string",
      "format": "date-time",
      "title": "Decided Date"
    },
    "alert_owner": {
      "type": "boolean",
      "title": "Owner Alerted",
      "default": false
    },
    "autonomy_downgraded": {
      "type": "boolean",
      "title": "Autonomy Downgraded",
      "default": false
    },
    "previous_autonomy_level": {
      "type": "string",
      "title": "Previous Autonomy"
    },
    "new_autonomy_level": {
      "type": "string",
      "title": "New Autonomy"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Evaluation Trace",
      "default": []
    }
  },
  "required": [
    "agent_id",
    "action_type",
    "target_system",
    "decision",
    "status"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}