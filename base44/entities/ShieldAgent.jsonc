{
  "name": "ShieldAgent",
  "type": "object",
  "title": "Shield Agent",
  "description": "A registered AI agent passport under governance.",
  "properties": {
    "agent_id": {
      "type": "string",
      "title": "Agent ID"
    },
    "name": {
      "type": "string",
      "title": "Agent Name"
    },
    "owner_name": {
      "type": "string",
      "title": "Owner Name"
    },
    "owner_email": {
      "type": "string",
      "format": "email",
      "title": "Owner Email"
    },
    "purpose": {
      "type": "string",
      "title": "Purpose"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Authorized Systems",
      "default": []
    },
    "financial_limit_usd": {
      "type": "number",
      "title": "Financial Limit (USD)",
      "default": 0
    },
    "financial_limit_mode": {
      "type": "string",
      "enum": [
        "approval_threshold",
        "hard_cap"
      ],
      "title": "Financial Limit Mode",
      "default": "approval_threshold"
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "full",
        "standard",
        "restricted"
      ],
      "title": "Autonomy Level",
      "default": "standard"
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Prohibited Actions",
      "default": []
    },
    "data_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Data Permissions",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "passport_version": {
      "type": "integer",
      "title": "Passport Version",
      "default": 1
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending_review",
        "reviewed",
        "needs_attention",
        "expired"
      ],
      "title": "Review Status",
      "default": "pending_review"
    },
    "runtime_health": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "unknown"
      ],
      "title": "Runtime Health",
      "default": "unknown"
    },
    "passport_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Passport Expiration"
    },
    "grants": {
      "type": "array",
      "title": "Function Grants",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "function": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "constraints": {
            "type": "string"
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "version_history": {
      "type": "array",
      "title": "Version History",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "version": {
            "type": "integer"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "is_sample": {
      "type": "boolean",
      "title": "Sample Data",
      "default": false
    }
  },
  "required": [
    "agent_id",
    "name",
    "owner_name",
    "owner_email",
    "purpose",
    "autonomy_level"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}