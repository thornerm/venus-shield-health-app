{
  "name": "Job Execution Governance",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "job_execution_governance",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "load_context": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "job-governance",
            "args": {
              "action": "context",
              "execution_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check_passport",
          "x-base44": {
            "title": "Resolve governing agent",
            "description": "Passport, params, admin"
          }
        }
      },
      {
        "check_passport": {
          "switch": [
            {
              "when": "${ .load_context.agent_id == null }",
              "then": "mark_failed"
            },
            {
              "when": "${ true }",
              "then": "evaluate_job"
            }
          ],
          "x-base44": {
            "title": "Has a passport?",
            "description": "No passport means no permission"
          }
        }
      },
      {
        "evaluate_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "evaluate-ui",
            "args": {
              "agent_id": "${ .load_context.agent_id }",
              "action_type": "dispatch_job",
              "target_system": "external_endpoint",
              "amount_usd": 0,
              "params": "${ .load_context.params }",
              "source": "orchestrator"
            }
          },
          "then": "check_verdict",
          "x-base44": {
            "title": "Evaluate against policies",
            "description": "Active ShieldPolicies"
          }
        }
      },
      {
        "check_verdict": {
          "switch": [
            {
              "when": "${ (.evaluate_job.decision // \"error\") == \"allow\" }",
              "then": "end"
            },
            {
              "when": "${ true }",
              "then": "enforce_job"
            }
          ],
          "x-base44": {
            "title": "Evaluation passed?",
            "description": "Allow continues, else enforce"
          }
        }
      },
      {
        "enforce_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "enforce",
            "args": {
              "agent_id": "${ .load_context.agent_id }",
              "action_type": "dispatch_job",
              "target_system": "external_endpoint",
              "amount_usd": 0,
              "params": "${ .load_context.params }"
            }
          },
          "then": "mark_failed",
          "x-base44": {
            "title": "Enforce verdict",
            "description": "Recorded in the audit trail"
          }
        }
      },
      {
        "mark_failed": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "job-governance",
            "args": {
              "action": "fail",
              "execution_id": "${ .trigger.entity_id }",
              "decision": "${ .evaluate_job.decision // \"blocked\" }",
              "reason": "${ .evaluate_job.reason // \"No approved passport matches this job's agent type.\" }"
            }
          },
          "then": "check_admin",
          "x-base44": {
            "title": "Mark job failed",
            "description": "Status and error message"
          }
        }
      },
      {
        "check_admin": {
          "switch": [
            {
              "when": "${ .load_context.admin_email != null }",
              "then": "alert_admin"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Admin found?",
            "description": "Skip alert if none"
          }
        }
      },
      {
        "alert_admin": {
          "call": "send_email",
          "with": {
            "template_name": "JobGovernanceAlert",
            "to": "${ .load_context.admin_email }",
            "category": "transactional",
            "description": "Tells the admin a job failed its governance check and why",
            "variables": {
              "job_name": "${ .load_context.job_name }",
              "task_uid": "${ .load_context.task_uid }",
              "agent_id": "${ .load_context.agent_id // \"none\" }",
              "reason": "${ .mark_failed.message }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Alert admin",
            "description": "Email with the reason"
          }
        }
      }
    ]
  },
  "description": "When a JobExecution is created, evaluate it against active policies. If it fails, enforce, mark the run failed and alert the admin.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "JobExecution"
    }
  }
}